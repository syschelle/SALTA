+/**
+ * Homematic IP uses separate mode data points for status and control on the
+ * established WTH/eTRV families: SET_POINT_MODE reports the active mode while
+ * CONTROL_MODE is the command endpoint. Newer R4M devices reverse that
+ * direction, so keep the exception explicit instead of guessing from the
+ * OPERATIONS flag (OpenCCU can expose the command data point as read-only).
+ */
+function hmIpThermostatModeReadOrder(snapshot: Pick<OpenCcuChannelSnapshot, "model">): string[] {
+  return isHomematicIpR4mThermostat(snapshot)
+    ? ["CONTROL_MODE", "SET_POINT_MODE", "MODE"]
+    : ["SET_POINT_MODE", "CONTROL_MODE", "MODE"];
+}
+
+function hmIpThermostatModeWriteParameter(snapshot: Pick<OpenCcuChannelSnapshot, "model">): "CONTROL_MODE" | "SET_POINT_MODE" {
+  return isHomematicIpR4mThermostat(snapshot) ? "SET_POINT_MODE" : "CONTROL_MODE";
+}
