{
  "name": "salta",
  "version": "0.8.114",
  "description": "SALTA local-first smart-home control plane",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node scripts/check-test-symbols.mjs --vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run validate:release && npm run test:preflight && node --check public/room-grouping.js && node --check public/automation-ui.js && node --check public/homekit-qr.js && node --check public/i18n.js && node --check public/login.js && node --check public/app.js && npm run build && npm run test:vitest",
    "validate:release": "node scripts/validate-release.mjs",
    "version:set": "node scripts/set-version.mjs",
    "test:preflight": "node scripts/check-test-symbols.mjs",
    "test:vitest": "node scripts/check-test-symbols.mjs --vitest-only"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@homebridge/hap-nodejs": "^2.1.9",
    "fastify": "^5.12.5",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "light-my-request": "^6.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "keywords": [
    "smart-home",
    "local-first",
    "homekit",
    "shelly",
    "zigbee",
    "hue-bridge",
    "philips-hue",
    "phoscon",
    "deconz",
    "openccu",
    "homematic",
    "homematic-ip",
    "virtual-device",
    "virtual-switch",
    "automation",
    "rules-engine"
  ],
  "overrides": {
    "find-my-way": "9.7.0",
    "@homebridge/dbus-native": "0.7.7",
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.8"
    },
    "ajv": {
      "fast-uri": "3.1.8"
    },
    "fast-json-stringify": {
      "fast-uri": "4.2.2"
    },
    "source-map-js": "1.2.2"
  }
}
